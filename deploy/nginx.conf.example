# heroicgameslauncher.com — nginx site config for the Next.js static export.
#
# Copy to /etc/nginx/sites-available/heroicgameslauncher.com, symlink into
# sites-enabled, then `nginx -t && systemctl reload nginx`.
#
# Why this file exists:
#
#   The site used to rely on a catch-all rewrite ("**" -> /index.html, see the
#   old firebase.json) so that every path returned the home page with HTTP 200.
#   That turned every typo into a duplicate home page (a soft 404 for Google)
#   and made /donate/ silently serve the home page instead of the donate page.
#   On top of that, Plausible records whatever path is in the address bar, so
#   /donate/ never matched a filter for "exit page is /donate".
#
#   The rules below serve real 404s, 301 every non-canonical URL form to the
#   canonical one (/donate/, /donate.html -> /donate), and keep the immutable
#   cache headers for the hashed _next assets.
#
# Replace the ssl_certificate paths with whatever the existing vhost uses
# (certbot usually writes /etc/letsencrypt/live/<domain>/...).

# ---------------------------------------------------------------------------
# HTTP -> HTTPS, and www -> apex
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name heroicgameslauncher.com www.heroicgameslauncher.com;

    # certbot's HTTP-01 challenge must stay reachable over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://heroicgameslauncher.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.heroicgameslauncher.com;

    ssl_certificate     /etc/letsencrypt/live/heroicgameslauncher.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/heroicgameslauncher.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    return 301 https://heroicgameslauncher.com$request_uri;
}

# ---------------------------------------------------------------------------
# Canonical site
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name heroicgameslauncher.com;

    ssl_certificate     /etc/letsencrypt/live/heroicgameslauncher.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/heroicgameslauncher.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    # Web root written by scripts/vps-pull-deploy.sh (WEBROOT).
    root /var/www/site;
    index index.html;

    charset utf-8;
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Keep the analytics URL identical for every visitor: /donate, never
    # /donate/ or /donate.html. This also stops the home page from being served
    # at a second URL.
    location ~ ^/(.+?)/$ {
        return 301 https://heroicgameslauncher.com/$1$is_args$args;
    }

    location ~ ^/(.+)\.html$ {
        return 301 https://heroicgameslauncher.com/$1$is_args$args;
    }

    # The Next.js export ships 404.html; it must only ever be used internally by
    # error_page (an exact-match location wins over the regexes above).
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    # Hashed build output: safe to cache forever.
    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Public images/fonts: long-lived but not immutable.
    location ~* \.(png|jpe?g|webp|avif|gif|svg|ico|woff2?)$ {
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    # Pages: /donate -> /donate.html, and a real 404 for anything else.
    # (No `**` fallback to index.html — that is the bug this config fixes.)
    location / {
        add_header Cache-Control "public, max-age=0, must-revalidate";
        try_files $uri $uri.html $uri/index.html =404;
    }
}
